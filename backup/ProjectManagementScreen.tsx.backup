                        <Select onValueChange={(value) => handleOtherSelection('panelBrand', value)}>
                          <SelectTrigger>
                            <SelectValue placeholder="Select Panel Brand" />
                          </SelectTrigger>
                          <SelectContent>
                            <SelectItem value="sunpower">SunPower</SelectItem>
