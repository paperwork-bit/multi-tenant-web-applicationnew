  const handleCalendarNavigation = (direction) => {
    const delta = direction === "next" ? 1 : -1;

    if (calendarViewType === "monthly") {
      setCalendarMonthDate((previous) => {
        const next = new Date(previous.getFullYear(), previous.getMonth() + delta, 1);
        next.setHours(0, 0, 0, 0);
        return next;
      });
    } else {
      setCalendarWeekStart((previous) => {
        const next = new Date(previous);
        next.setDate(next.getDate() + delta * 7);
        next.setHours(0, 0, 0, 0);
        return next;
      });
    }
  };

  const handleScheduleItemClick = (scheduleItem) => {
    setSelectedScheduleItem(scheduleItem);
    setShowScheduleDetails(true);
  };

  const handleEditSchedule = () => {
    setEditingScheduleItem({ ...selectedScheduleItem });
    setShowScheduleDetails(false);
    setShowEditSchedule(true);
  };

  const handleSaveScheduleChanges = () => {
    // Here you would typically update the schedule in your data store
    console.log("Saving schedule changes:", editingScheduleItem);
    
    // Update the schedule data (this would normally be done via API call)
    // For now, we'll just close the dialog
    setShowEditSchedule(false);
    setEditingScheduleItem(null);
    
    // Show success message
    alert("Schedule updated successfully!");
  };

  const handleEditMember = () => {
    setEditingMember({ ...selectedTeamMember });
    setShowTeamMemberDialog(false);
    setShowEditMember(true);
  };

  const handleSaveMemberChanges = () => {
    // Here you would typically update the team member in your data store
    console.log("Saving member changes:", editingMember);
    
    // Update the team data (this would normally be done via API call)
    // For now, we'll just close the dialog
    setShowEditMember(false);
    setEditingMember(null);
    
    // Show success message
    alert("Team member updated successfully!");
  };

  const handleOtherSelection = (field, value) => {
    setOtherSelections(prev => ({
      ...prev,
      [field]: value
    }));
  };

  const formatTimeDisplay = (time) => {
    const timeMap = {
      '09:00': '9:00 AM',
      '10:00': '10:00 AM',
      '11:00': '11:00 AM',
      '12:00': '12:00 PM',
      '13:00': '1:00 PM',
      '14:00': '2:00 PM',
      '15:00': '3:00 PM',
      '16:00': '4:00 PM',
      '17:00': '5:00 PM'
    };
    return timeMap[time] || time;
  };

  const handleNewProjectSubmit = () => {
    // CRITICAL: Check quota FIRST before doing anything
    // If quota exceeded, show warning but still save locally
    const quotaExceeded = checkQuotaExceeded() || quotaExceededRef.current || firestoreQuotaExceeded;
    if (quotaExceeded) {
      // Set flags to ensure no Firestore operations are attempted
      quotaExceededRef.current = true;
      if (!firestoreQuotaExceeded) {
        setFirestoreQuotaExceeded(true);
      }
      // Show warning but continue with local save
      if (confirm('Firestore quota exceeded. Project will be saved locally only and will sync when quota resets. Continue?')) {
        // User confirmed - continue with local save only
      } else {
        return; // User cancelled
      }
    }
    
    // Validate required fields
    if (!newProject.customerName || !newProject.customerEmail || !newProject.customerContact || !newProject.customerAddress) {
      alert('Please fill in all required customer information fields (Customer Name, Email, Contact Number, and Address).');
      return;
    }

    // Determine the target column based on job type or status
    let targetColumnId = "new"; // Default column
    let projectStatus = "new"; // Default status
    
    // Check jobType first, then fallback to status
    const jobTypeToUse = newProject.jobType || newProject.status;
    
    if (jobTypeToUse === "site-inspection") {
      targetColumnId = "site-inspection";
      projectStatus = "site-inspection";
    } else if (jobTypeToUse === "stage-1") {
      targetColumnId = "stage-1";
      projectStatus = "stage-1";
    } else if (jobTypeToUse === "stage-2") {
      targetColumnId = "stage-2";
      projectStatus = "stage-2";
    } else if (jobTypeToUse === "full-system") {
      targetColumnId = "full-system";
      projectStatus = "full-system";
    }

    // Create the new project object - explicitly exclude any CRM fields
    const newProjectData = {
      id: Date.now(), // Generate unique ID
      title: newProject.title || `${newProject.customerName} - ${newProject.jobType}`,
      assignee: newProject.assignees.length > 0 ? newProject.assignees[0].split(' ').map(n => n[0]).join('') : "PM",
      assignees: newProject.assignees.length > 0 ? newProject.assignees : ["Project Manager"],
      date: newProject.startDate && newProject.endDate ? 
            `${new Date(newProject.startDate).toLocaleDateString()} - ${new Date(newProject.endDate).toLocaleDateString()}` : 
            "TBD",
      startDate: newProject.startDate || null,
      endDate: newProject.endDate || null,
      tags: [
        newProject.systemSize ? `${newProject.systemSize}kW System` : "System",
        newProject.clientType === "builder" ? "Builder" : "Residential"
      ],
      priority: newProject.priority || "medium",
      value: newProject.value || "TBD",
      status: projectStatus,
      customerName: newProject.customerName,
      customerEmail: newProject.customerEmail,
      customerContact: newProject.customerContact,
      customerAddress: newProject.customerAddress,
      location: newProject.location,
      // Property Information
      houseStorey: newProject.houseStorey,
      roofType: newProject.roofType,
      meterPhase: newProject.meterPhase,
      accessTo2ndStorey: newProject.accessTo2ndStorey,
      accessToInverter: newProject.accessToInverter,
      // Utility Information
      preApprovalNumber: newProject.preApprovalNumber,
      energyRetailer: newProject.energyRetailer,
      distributor: newProject.distributor,
      solarVictoriaEligible: newProject.solarVictoriaEligible,
      nmiNumber: newProject.nmiNumber,
      meterNumber: newProject.meterNumber,
      systemType: newProject.projectType || selectedSystemType || "pv-only",
      systemSize: newProject.systemSize,
      inverterSize: newProject.inverterSize,
      batterySize: newProject.batterySize,
      // Job type specific data
      jobType: newProject.jobType || newProject.status || "",
      clientType: newProject.clientType,
      clientName: newProject.clientName,
      // Booking information
      inspectionDate: newProject.inspectionDate,
      inspectionTime: newProject.inspectionTime,
      inspectionBooked: newProject.inspectionBooked,
      stage1Date: newProject.stage1Date,
      stage1Booked: newProject.stage1Booked,
      stage2Date: newProject.stage2Date,
      stage2Booked: newProject.stage2Booked,
      fullSystemDate: newProject.fullSystemDate,
      fullSystemBooked: newProject.fullSystemBooked,
      // Mark source so we never enrich with Leads CRM data for PM-created projects
      source: 'pm',
      // Explicitly set CRM fields to undefined to prevent any accidental enrichment
      projectSnapshot: undefined,
      siteVisit: undefined,
      onField: undefined,
      comments: [
        {
          id: `new-${Date.now()}`,
          text: `Project created with job type: ${newProject.jobType}. ${newProject.clientType ? `Client type: ${newProject.clientType}.` : ''} ${newProject.clientName ? `Client: ${newProject.clientName}.` : ''}`,
          author: "Project Manager",
          email: "pm@xtechs.com",
          timestamp: new Date().toLocaleString()
        }
      ]
    };

    // Update the kanban columns to add the project to the appropriate column
    // Ensure PM projects never have CRM data in the columns state
    const cleanProjectData = {
      ...newProjectData,
      projectSnapshot: undefined,
      siteVisit: undefined,
      onField: undefined,
    };
    // Update the columns state - use functional update to ensure we have the latest state
    setColumns((prevColumns) => {
      if (!prevColumns || !Array.isArray(prevColumns)) {
        // If columns not initialized, return default structure with the new project
        const defaultColumns = [
          { id: 'new', title: 'New', color: 'border-gray-300', projects: [] },
          { id: 'site-inspection', title: 'Site Inspection', color: 'border-purple-300', projects: [] },
          { id: 'stage-1', title: 'Stage 1', color: 'border-orange-300', projects: [] },
          { id: 'stage-2', title: 'Stage 2', color: 'border-yellow-300', projects: [] },
          { id: 'full-system', title: 'Full System', color: 'border-green-300', projects: [] },
        ];
        const targetCol = defaultColumns.find(c => c.id === targetColumnId) || defaultColumns[0];
        targetCol.projects = [cleanProjectData];
        return defaultColumns;
      }
      
      // Update existing columns
      return prevColumns.map(column => {
      if (column.id === targetColumnId) {
        return {
          ...column,
            projects: [...(column.projects || []), cleanProjectData]
        };
      }
      return column;
      });
    });

    console.log("Creating new project with data:", cleanProjectData);
    console.log("Adding to column:", targetColumnId);
    // Persist minimal project list for cross-screen access (e.g., Subcontractor Site Visit)
    // Use cleanProjectData to ensure no CRM fields are saved
    try {
      const prev = JSON.parse(localStorage.getItem('xtr_projects') || '[]');
      const next = Array.isArray(prev) ? [cleanProjectData, ...prev] : [cleanProjectData];
      localStorage.setItem('xtr_projects', JSON.stringify(next));
      try { window.dispatchEvent(new Event('xtr-projects-updated')); } catch {}
    } catch {}
    // Persist to Firestore for cross-device visibility - use cleanProjectData
    // CRITICAL: Only attempt Firestore if quota is NOT exceeded
    // Data is already saved locally, so Firestore is optional
    if (!quotaExceeded) {
      try {
        // Triple-check quota before attempting Firestore operation
        const quotaCheck1 = checkQuotaExceeded();
        const quotaCheck2 = quotaExceededRef.current;
        const quotaCheck3 = firestoreQuotaExceeded;
        
        // Only attempt if ALL checks pass
        if (!quotaCheck1 && !quotaCheck2 && !quotaCheck3 && firebaseEnabled && db) {
          // Final check right before calling addDoc
          if (!checkQuotaExceeded() && !quotaExceededRef.current) {
            addDoc(collection(db, 'pm_projects'), cleanProjectData as any).catch((err: any) => {
              if (err?.code === 'resource-exhausted') {
                // Set quota flags immediately to prevent ALL future operations
                quotaExceededRef.current = true;
                setQuotaExceeded(true);
                // Firebase SDK will log the error - we've now stopped all future operations
              }
            });
          }
        }
      } catch (err: any) {
        if (err?.code === 'resource-exhausted') {
          quotaExceededRef.current = true;
          setQuotaExceeded(true);
        }
      }
    }
    // Note: Project is already saved locally, so success message is shown regardless of Firestore status
    
    const successMessage = quotaExceeded 
      ? `New project created successfully and added to ${targetColumnId.replace('-', ' ').replace(/\b\w/g, l => l.toUpperCase())} column! (Saved locally - will sync when quota resets)`
      : `New project created successfully and added to ${targetColumnId.replace('-', ' ').replace(/\b\w/g, l => l.toUpperCase())} column!`;
    alert(successMessage);
    
    setShowNewProjectDialog(false);
    isDialogOpenRef.current = false;
    setSelectedSystemType("");
    setOtherSelections({});
    setNewProject({
      title: "",
      assignee: "",
      assignees: [],
      startDate: "",
      endDate: "",
      priority: "",
      clientType: "",
      clientName: "",
      jobType: "",
      inspectionDate: "",
      inspectionTime: "",
      inspectionBooked: false,
      stage1Date: "",
      stage1Time: "",
      stage1Booked: false,
      stage2Date: "",
      stage2Time: "",
      stage2Booked: false,
      fullSystemDate: "",
      fullSystemTime: "",
      fullSystemBooked: false,
      systemSize: "",
      projectType: "",
      value: "",
      description: "",
      customerName: "",
      customerEmail: "",
      customerContact: "",
      customerAddress: "",
      location: "",
      houseStorey: "",
      roofType: "",
      meterPhase: "",
      accessTo2ndStorey: "",
      accessToInverter: "",
      preApprovalNumber: "",
      energyRetailer: "",
      distributor: "",
      solarVictoriaEligible: "",
      nmiNumber: "",
      meterNumber: "",
      inverterSize: "",
      batterySize: "",
      panelBrand: "",
      inverterBrand: "",
      batteryBrand: "",
      evChargerBrand: ""
    });
  };

  const handleExportConfirm = () => {
    alert("Schedule exported successfully!");
    setShowExportDialog(false);
  };

  const [pmProjectsFs, setPmProjectsFs] = useState<any[]>([]);
  const [leadsColumnsFs, setLeadsColumnsFs] = useState<any[] | null>(null);
  
  // Helper function to check if quota is exceeded (checks localStorage directly)
  // Defined as a regular function so it can be called synchronously before useState
  const checkQuotaExceeded = (): boolean => {
    try {
      const stored = localStorage.getItem('firestore_quota_exceeded');
      if (stored === 'true') {
        const quotaTime = localStorage.getItem('firestore_quota_time');
        if (quotaTime) {
          const timeDiff = Date.now() - parseInt(quotaTime, 10);
          // Auto-reset after 24 hours (86400000 ms)
          if (timeDiff > 86400000) {
            localStorage.removeItem('firestore_quota_exceeded');
            localStorage.removeItem('firestore_quota_time');
            return false;
          }
        }
        return true;
      }
    } catch (e) {
      // Ignore localStorage errors
    }
    return false;
  };

  // Initialize quota state from localStorage to persist across page reloads
  // Check synchronously before any other code runs
  const [firestoreQuotaExceeded, setFirestoreQuotaExceeded] = useState(() => checkQuotaExceeded());
  
  // Memoized version for use in callbacks and effects
  const isQuotaExceeded = useCallback(() => checkQuotaExceeded(), []);
  
  // Helper function to set quota exceeded state and persist it
  const setQuotaExceeded = useCallback((value: boolean) => {
    setFirestoreQuotaExceeded(value);
    try {
      if (value) {
        localStorage.setItem('firestore_quota_exceeded', 'true');
        localStorage.setItem('firestore_quota_time', Date.now().toString());
      } else {
        localStorage.removeItem('firestore_quota_exceeded');
        localStorage.removeItem('firestore_quota_time');
      }
    } catch (e) {
      // Ignore localStorage errors
    }
  }, []);
  
  const isDialogOpenRef = useRef(false);
  const mergeInProgressRef = useRef(false);
  const firestoreUnsubscribesRef = useRef<Array<() => void>>([]);
  // Global ref to track quota status - checked before ANY Firestore operation
  const quotaExceededRef = useRef(checkQuotaExceeded());
  
  // Update ref whenever quota status changes
  useEffect(() => {
    quotaExceededRef.current = checkQuotaExceeded() || firestoreQuotaExceeded;
  }, [firestoreQuotaExceeded]);
  
  // Check quota status on mount and before any Firestore operations
  // This MUST run synchronously before any other effects that might trigger Firebase operations
  useEffect(() => {
    const quotaExceeded = checkQuotaExceeded();
    quotaExceededRef.current = quotaExceeded;
    if (quotaExceeded && !firestoreQuotaExceeded) {
      setFirestoreQuotaExceeded(true);
      // Immediately unsubscribe all listeners
      firestoreUnsubscribesRef.current.forEach(unsub => {
        try {
          if (typeof unsub === 'function') unsub();
        } catch (e) {}
      });
      firestoreUnsubscribesRef.current = [];
    }
  }, []); // Run only once on mount
  
  // Helper to check if we can use Firestore (fast synchronous check)
  const canUseFirestore = useCallback(() => {
    if (quotaExceededRef.current) return false;
    if (checkQuotaExceeded()) {
      quotaExceededRef.current = true;
      return false;
    }
    return true;
  }, []);

  const handleForceSync = async () => {
    try {
      // Check quota BEFORE doing anything
      if (firestoreQuotaExceeded || isQuotaExceeded()) {
        alert('Firestore quota exceeded. Please try again later or upgrade your Firebase plan.');
        if (!firestoreQuotaExceeded) {
          setFirestoreQuotaExceeded(true);
        }
        return;
      }
      const raw = localStorage.getItem('xtr_projects');
      const arr = raw ? JSON.parse(raw) : [];
      if (!firebaseEnabled || !db) { alert('Cloud sync unavailable.'); return; }
      if (!Array.isArray(arr) || arr.length === 0) { alert('No local projects to sync.'); return; }
      // Check quota again before starting sync
      if (isQuotaExceeded()) {
        alert('Firestore quota exceeded. Please try again later or upgrade your Firebase plan.');
        setFirestoreQuotaExceeded(true);
        return;
      }
      const fsKeys = new Set((pmProjectsFs || []).map((p: any) => (
        String(p.id || '') + '|' + String(p.customerEmail || '') + '|' + String(p.customerAddress || '')
      )));
      let uploaded = 0;
      let quotaError = false;
      for (const p of arr) {
        // Check quota before each upload
        if (quotaError || isQuotaExceeded() || firestoreQuotaExceeded) {
          quotaError = true;
          if (!firestoreQuotaExceeded) {
            setFirestoreQuotaExceeded(true);
          }
          break;
        }
        const key = String(p.id || '') + '|' + String(p.customerEmail || '') + '|' + String(p.customerAddress || '')
        if (!fsKeys.has(key)) {
          try {
            await addDoc(collection(db, 'pm_projects'), p as any);
            uploaded++;
          } catch (err: any) {
            if (err?.code === 'resource-exhausted') {
              quotaError = true;
              setQuotaExceeded(true);
              break; // Stop trying if quota exceeded
            } else if (!isQuotaExceeded() && !firestoreQuotaExceeded) {
              console.warn('Failed to sync project:', err?.message || err);
            }
          }
        }
      }
      if (quotaError || isQuotaExceeded()) {
        alert('Firestore quota exceeded. Some projects may not have synced. Please try again later.');
      } else {
        alert(uploaded > 0 ? `Synced ${uploaded} project(s) to cloud.` : 'All projects already in cloud.');
      }
      try { window.dispatchEvent(new Event('xtr-projects-updated')); } catch {}
    } catch (err: any) {
      if (err?.code === 'resource-exhausted') {
        setQuotaExceeded(true);
        alert('Firestore quota exceeded. Please try again later or upgrade your Firebase plan.');
      } else {
        console.error('Sync failed:', err?.message || err);
        alert('Sync failed. Please check your connection and try again.');
      }
    }
  };

  // Firestore subscription for cross-device PM projects
  useEffect(() => {
    // Check quota BEFORE setting up subscription (use ref for fast check)
    if (quotaExceededRef.current || firestoreQuotaExceeded || !canUseFirestore()) {
      // Unsubscribe all listeners if quota exceeded
      firestoreUnsubscribesRef.current.forEach(unsub => {
        try {
          if (typeof unsub === 'function') unsub();
        } catch (e) {
          // Ignore unsubscribe errors
        }
      });
      firestoreUnsubscribesRef.current = [];
      if (!firestoreQuotaExceeded) {
        setFirestoreQuotaExceeded(true);
        quotaExceededRef.current = true;
      }
      return;
    }
    
    let unsub: (() => void) | undefined;
    if (firebaseEnabled && db && canUseFirestore() && !quotaExceededRef.current) {
      try {
        unsub = onSnapshot(
          collection(db, 'pm_projects'),
          (snap: any) => {
            // Don't process if quota exceeded during callback
            if (firestoreQuotaExceeded) return;
            try {
              const arr = snap?.docs?.map((d: any) => d?.data && typeof d.data === 'function' ? d.data() : d?.data()) || [];
              if (Array.isArray(arr)) setPmProjectsFs(arr as any);
            } catch (err: any) {
              // Silently ignore errors when quota is exceeded
              if (err?.code !== 'resource-exhausted') {
                console.warn('Error processing pm_projects snapshot:', err?.message || err);
              }
            }
          },
          (err: any) => {
            // Handle Firestore errors gracefully
            if (err?.code === 'resource-exhausted') {
              // Immediately set quota flag in localStorage and ref to prevent any further operations
              try {
                localStorage.setItem('firestore_quota_exceeded', 'true');
                localStorage.setItem('firestore_quota_time', Date.now().toString());
              } catch (e) {}
              quotaExceededRef.current = true; // Set ref immediately for fast checks
              // Only log once, don't spam console
              if (!firestoreQuotaExceeded) {
                console.warn('Firestore quota exceeded. Switching to offline mode. All data will be saved locally.');
              }
              setQuotaExceeded(true);
              // Unsubscribe all listeners immediately
              firestoreUnsubscribesRef.current.forEach(u => {
                try {
                  if (typeof u === 'function') u();
                } catch (e) {}
              });
              firestoreUnsubscribesRef.current = [];
              if (typeof unsub === 'function') {
                try {
                  unsub();
                } catch (e) {}
              }
            } else if (err?.code === 'unavailable') {
              // Don't log unavailable errors if quota already exceeded
              if (!firestoreQuotaExceeded && !isQuotaExceeded()) {
                console.warn('Firestore unavailable. Using local data only.');
              }
            } else if (!firestoreQuotaExceeded && !isQuotaExceeded()) {
              console.warn('Firestore subscription error:', err?.message || err);
            }
          }
        );
        if (unsub) {
          firestoreUnsubscribesRef.current.push(unsub);
        }
      } catch (err: any) {
        if (err?.code === 'resource-exhausted') {
          quotaExceededRef.current = true;
          setQuotaExceeded(true);
        } else if (!firestoreQuotaExceeded && !quotaExceededRef.current) {
          console.warn('Failed to setup pm_projects subscription:', err?.message || err);
        }
      }
    }
    return () => {
      if (typeof unsub === 'function') {
        try {
          unsub();
          firestoreUnsubscribesRef.current = firestoreUnsubscribesRef.current.filter(u => u !== unsub);
        } catch (e) {
          // Ignore unsubscribe errors
        }
      }
    };
  }, [firestoreQuotaExceeded]);

  // Fallback: subscribe to Leads CRM columns and derive PM items for Closed Won
  useEffect(() => {
    // Check quota BEFORE setting up subscription
    if (firestoreQuotaExceeded || isQuotaExceeded()) {
      // Already unsubscribed in previous effect
      if (firestoreQuotaExceeded !== true) {
        setFirestoreQuotaExceeded(true);
      }
      return;
    }
    
    let unsub: (() => void) | undefined;
    if (firebaseEnabled && db && !isQuotaExceeded()) {
      try {
        unsub = onSnapshot(
          doc(db, 'leads_state', 'columns'),
          (snap: any) => {
            // Don't process if quota exceeded during callback
            if (firestoreQuotaExceeded) return;
            try {
              const data = typeof snap?.data === 'function' ? snap.data() : undefined;
              if (data && Array.isArray(data.columns)) setLeadsColumnsFs(data.columns as any);
            } catch (err: any) {
              // Silently ignore errors when quota is exceeded
              if (err?.code !== 'resource-exhausted' && !firestoreQuotaExceeded) {
                console.warn('Error processing leads_state snapshot:', err?.message || err);
              }
            }
          },
          (err: any) => {
            // Handle Firestore errors gracefully
            if (err?.code === 'resource-exhausted') {
              setQuotaExceeded(true);
              // Unsubscribe all listeners
              firestoreUnsubscribesRef.current.forEach(u => {
                try {
                  if (typeof u === 'function') u();
                } catch (e) {}
              });
              firestoreUnsubscribesRef.current = [];
              if (typeof unsub === 'function') {
                try {
                  unsub();
                } catch (e) {}
              }
            } else if (err?.code === 'unavailable') {
              // Don't log unavailable errors if quota already exceeded
              if (!firestoreQuotaExceeded) {
                console.warn('Firestore unavailable. Using local data only.');
              }
            } else if (!firestoreQuotaExceeded) {
              console.warn('Firestore subscription error:', err?.message || err);
            }
          }
        );
        if (unsub) {
          firestoreUnsubscribesRef.current.push(unsub);
        }
      } catch (err: any) {
        if (err?.code === 'resource-exhausted') {
          setQuotaExceeded(true);
        } else if (!firestoreQuotaExceeded) {
          console.warn('Failed to setup leads_state subscription:', err?.message || err);
        }
      }
    }
    return () => {
      if (typeof unsub === 'function') {
        try {
          unsub();
          firestoreUnsubscribesRef.current = firestoreUnsubscribesRef.current.filter(u => u !== unsub);
        } catch (e) {
          // Ignore unsubscribe errors
        }
      }
    };
  }, [firestoreQuotaExceeded]);

  // Initialize columns state
  React.useEffect(() => {
    // Seed with default columns (inline to avoid TDZ on consts)
    setColumns([
      { id: 'new', title: 'New', color: 'border-gray-300', projects: [] },
      { id: 'site-inspection', title: 'Site Inspection', color: 'border-purple-300', projects: [] },
      { id: 'stage-1', title: 'Stage 1', color: 'border-orange-300', projects: [] },
      { id: 'stage-2', title: 'Stage 2', color: 'border-yellow-300', projects: [] },
      { id: 'full-system', title: 'Full System', color: 'border-green-300', projects: [] },
      { id: 'canceled', title: 'Canceled', color: 'border-red-300', projects: [] },
      { id: 'to-be-scheduled', title: 'To Be Scheduled', color: 'border-blue-300', projects: [] },
      { id: 'scheduled', title: 'Scheduled', color: 'border-green-300', projects: [] },
      { id: 'to-be-rescheduled', title: 'To Be Rescheduled', color: 'border-yellow-300', projects: [] },
      { id: 'completed', title: 'Completed', color: 'border-green-300', projects: [] },
      { id: 'ces-certificate-applied', title: 'CES Certificate Applied', color: 'border-teal-500', projects: [] },
      { id: 'ces-certificate-received', title: 'CES Certificate Received', color: 'border-teal-500', projects: [] },
      { id: 'ces-certificate-submitted', title: 'CES Certificate Submitted', color: 'border-teal-500', projects: [] },
      { id: 'grid-connect-initiated', title: 'Grid Connect Initiated', color: 'border-indigo-500', projects: [] },
      { id: 'grid-connection-completed', title: 'Grid Connection Completed', color: 'border-indigo-500', projects: [] },
      { id: 'system-handover', title: 'System Handover', color: 'border-green-500', projects: [] },
      { id: 'done', title: 'Done', color: 'border-gray-500', projects: [] },
    ]);
    // Then merge any locally created projects (from Sales) into the 'new' column
    const mergeFromLocal = () => {
      try {
        const raw = localStorage.getItem('xtr_projects');
        const incomingLocal = raw ? JSON.parse(raw) : [];
        const baseIncoming = Array.isArray(incomingLocal) ? incomingLocal : [];
        // Derive Closed Won PM items from leads columns
        const fromLeads: any[] = [];
        try {
          if (Array.isArray(leadsColumnsFs)) {
            (leadsColumnsFs as any[]).forEach((col: any) => {
              const leads = Array.isArray(col?.leads) ? col.leads : [];
              leads.forEach((l: any) => {
                if ((l?.status || '') === 'closed-won' && l?.linkedProject) {
                  fromLeads.push({
                    id: l.linkedProject.id,
                    title: l.linkedProject.title,
                    status: 'new',
                    date: new Date().toISOString().slice(0,10),
                    tags: [l?.projectDetails?.systemInfo?.systemSize || '', l?.projectDetails?.systemType || ''].filter(Boolean),
                    priority: 'medium',
                    value: l.value || '',
                    customerName: l.title,
                    customerEmail: (l.tags && l.tags[0]) || '',
                    customerContact: l.value || '',
                    customerAddress: l.company || '',
                    projectSnapshot: (l as any).projectSnapshot || undefined,
                    siteVisit: (l as any).siteVisit || undefined,
                    onField: (l as any).onField || undefined,
                    comments: Array.isArray(l?.comments) ? l.comments : [],
                  });
                }
              });
            });
          }
        } catch {}
        const incoming = [
          ...baseIncoming,
          ...(Array.isArray(pmProjectsFs) ? pmProjectsFs : []),
          ...fromLeads,
        ];
        if (!Array.isArray(incoming)) return;
        // Defer backfill to avoid blocking initial render - run after UI is ready
        const runBackfill = () => {
          try {
            // CRITICAL: Check quota FIRST before doing anything
            // Use multiple checks to be absolutely sure
            const quotaCheck1 = checkQuotaExceeded();
            const quotaCheck2 = quotaExceededRef.current;
            const quotaCheck3 = firestoreQuotaExceeded;
            
            if (quotaCheck1 || quotaCheck2 || quotaCheck3) {
              // Quota exceeded - set all flags and exit immediately
              quotaExceededRef.current = true;
              if (!firestoreQuotaExceeded) {
                setFirestoreQuotaExceeded(true);
              }
              return; // EXIT IMMEDIATELY - DON'T ATTEMPT ANY OPERATIONS
            }
            
            // Final check using helper function
            if (!canUseFirestore()) {
              quotaExceededRef.current = true;
              setFirestoreQuotaExceeded(true);
              return; // EXIT IMMEDIATELY
            }
            
            // Only proceed if ALL checks pass
            if (firebaseEnabled && db && Array.isArray(baseIncoming)) {
              const fsKeys = new Set(
                (pmProjectsFs || []).map((p: any) => (
                  String(p.id || '') + '|' + String(p.customerEmail || '') + '|' + String(p.customerAddress || '')
                ))
              );
              let uploaded = 0;
              let quotaHit = false;
              
              for (const p of baseIncoming) {
                // CRITICAL: Check quota BEFORE each iteration
                // If quota exceeded, break immediately
                if (quotaHit || quotaExceededRef.current || checkQuotaExceeded() || firestoreQuotaExceeded || !canUseFirestore()) {
                  quotaHit = true;
                  quotaExceededRef.current = true;
                  setFirestoreQuotaExceeded(true);
                  break; // STOP IMMEDIATELY
                }
                
                const key = String(p.id || '') + '|' + String(p.customerEmail || '') + '|' + String(p.customerAddress || '')
                
                // Only attempt upload if key doesn't exist AND quota is OK
                if (!fsKeys.has(key)) {
                  // FINAL check right before calling addDoc
                  if (checkQuotaExceeded() || quotaExceededRef.current || firestoreQuotaExceeded || !canUseFirestore()) {
                    quotaHit = true;
                    quotaExceededRef.current = true;
                    setFirestoreQuotaExceeded(true);
                    break; // STOP IMMEDIATELY
                  }
                  
                  // Only call addDoc if we're 100% sure quota is OK
                  addDoc(collection(db, 'pm_projects'), p as any).then(() => {
                    // Only count as uploaded if quota is still OK
                    if (!checkQuotaExceeded() && !quotaExceededRef.current && !firestoreQuotaExceeded && canUseFirestore()) {
                      uploaded += 1;
                    }
                  }).catch((err: any) => {
                    if (err?.code === 'resource-exhausted') {
                      // Quota exceeded - set flags and stop ALL operations
                      quotaHit = true;
                      quotaExceededRef.current = true;
                      setQuotaExceeded(true);
                      // Don't log - Firebase SDK will log it
                      // Break out of loop immediately
                    }
                  });
                  
                  // If quota was hit, break immediately
                  if (quotaHit) {
                    break;
                  }
                }
              }
              
              // Only log success if we actually uploaded AND quota is still OK
              if (uploaded > 0 && !quotaHit && !checkQuotaExceeded() && !quotaExceededRef.current && !firestoreQuotaExceeded && canUseFirestore()) {
                try { console.info(`PM sync: uploaded ${uploaded} project(s) to cloud.`); } catch {}
              }
            }
          } catch (err: any) {
            // Catch any unexpected errors
            if (err?.code === 'resource-exhausted') {
              quotaExceededRef.current = true;
              setFirestoreQuotaExceeded(true);
            }
          }
        };
        // Defer backfill operation to not block initial render
        // CRITICAL: Check quota BEFORE scheduling - if quota exceeded, DON'T SCHEDULE AT ALL
        // Use multiple checks to be absolutely sure quota is not exceeded
        const quotaCheck1 = checkQuotaExceeded();
        const quotaCheck2 = quotaExceededRef.current;
        const quotaCheck3 = firestoreQuotaExceeded;
        
        // Only schedule backfill if ALL quota checks pass
        if (!quotaCheck1 && !quotaCheck2 && !quotaCheck3) {
          if (typeof requestIdleCallback !== 'undefined') {
            requestIdleCallback(() => {
              // Triple-check quota before running backfill (quota might have changed during defer)
              const deferredCheck1 = checkQuotaExceeded();
              const deferredCheck2 = quotaExceededRef.current;
              const deferredCheck3 = firestoreQuotaExceeded;
              
              // Only run if ALL checks pass
              if (!deferredCheck1 && !deferredCheck2 && !deferredCheck3) {
                runBackfill();
              } else {
                // Quota exceeded during defer - set flags and skip backfill completely
                quotaExceededRef.current = true;
                if (!firestoreQuotaExceeded) {
                  setFirestoreQuotaExceeded(true);
                }
              }
            }, { timeout: 3000 });
          } else {
            setTimeout(() => {
              // Triple-check quota before running backfill (quota might have changed during defer)
              const deferredCheck1 = checkQuotaExceeded();
              const deferredCheck2 = quotaExceededRef.current;
              const deferredCheck3 = firestoreQuotaExceeded;
              
              // Only run if ALL checks pass
              if (!deferredCheck1 && !deferredCheck2 && !deferredCheck3) {
                runBackfill();
              } else {
                // Quota exceeded during defer - set flags and skip backfill completely
                quotaExceededRef.current = true;
                if (!firestoreQuotaExceeded) {
                  setFirestoreQuotaExceeded(true);
                }
              }
            }, 1000);
          }
        } else {
          // Quota exceeded - don't schedule backfill at all
          // Set flags to ensure all future operations are blocked
          quotaExceededRef.current = true;
          if (!firestoreQuotaExceeded) {
            setFirestoreQuotaExceeded(true);
          }
        }
        // Attempt to enrich from Leads CRM persisted state so older PM cards get details
        let leadsColumns: any[] | undefined;
        try {
          const lc = localStorage.getItem('xtr_leads_state_columns');
          const lcObj = lc ? JSON.parse(lc) : {};
          if (lcObj && Array.isArray(lcObj.columns)) leadsColumns = lcObj.columns;
        } catch {}
        setColumns((prev) => {
          const defaultColumns = [
            { id: 'new', title: 'New', color: 'border-gray-300', projects: [] },
            { id: 'site-inspection', title: 'Site Inspection', color: 'border-purple-300', projects: [] },
            { id: 'stage-1', title: 'Stage 1', color: 'border-orange-300', projects: [] },
            { id: 'stage-2', title: 'Stage 2', color: 'border-yellow-300', projects: [] },
            { id: 'full-system', title: 'Full System', color: 'border-green-300', projects: [] },
            { id: 'canceled', title: 'Canceled', color: 'border-red-300', projects: [] },
            { id: 'to-be-scheduled', title: 'To Be Scheduled', color: 'border-blue-300', projects: [] },
            { id: 'scheduled', title: 'Scheduled', color: 'border-green-300', projects: [] },
            { id: 'to-be-rescheduled', title: 'To Be Rescheduled', color: 'border-yellow-300', projects: [] },
            { id: 'completed', title: 'Completed', color: 'border-green-300', projects: [] },
            { id: 'ces-certificate-applied', title: 'CES Certificate Applied', color: 'border-teal-500', projects: [] },
            { id: 'ces-certificate-received', title: 'CES Certificate Received', color: 'border-teal-500', projects: [] },
            { id: 'ces-certificate-submitted', title: 'CES Certificate Submitted', color: 'border-teal-500', projects: [] },
            { id: 'grid-connect-initiated', title: 'Grid Connect Initiated', color: 'border-indigo-500', projects: [] },
            { id: 'grid-connection-completed', title: 'Grid Connection Completed', color: 'border-indigo-500', projects: [] },
            { id: 'system-handover', title: 'System Handover', color: 'border-green-500', projects: [] },
            { id: 'done', title: 'Done', color: 'border-gray-500', projects: [] },
          ];
          const base = prev ?? defaultColumns;
          const incomingCards = incoming.map((p: any) => {
            // backfill finder - match by linked id (preferred) or by name/email/address
            const findLeadMatch = (): any | undefined => {
              if (!leadsColumns || leadsColumns.length === 0) return undefined;
              let match: any | undefined;
              for (const col of leadsColumns) {
                const leads = Array.isArray(col?.leads) ? col.leads : [];
                for (const l of leads) {
                  const idMatch = String(l?.linkedProject?.id || '') === String(p?.id || '');
                  const nameMatch = String(l?.title || '').trim().toLowerCase() === String(p?.customerName || '').trim().toLowerCase();
                  const emailMatch = String(l?.tags?.[0] || '').trim().toLowerCase() === String(p?.customerEmail || '').trim().toLowerCase();
                  const addrMatch = String(l?.company || '').trim().toLowerCase() === String(p?.customerAddress || '').trim().toLowerCase();
                  if (idMatch || nameMatch || emailMatch || addrMatch) { match = l; break; }
                }
                if (match) break;
              }
              return match;
            };
            // NEVER enrich PM-created projects with CRM data - they are completely separate
            const pmColumns = ['site-inspection', 'stage-1', 'stage-2', 'full-system'];
            const isPmColumn = pmColumns.includes(String(p.status || ''));
            const isPmCreated = String(p.source || '') === 'pm' || !!p.jobType || isPmColumn;
            const leadMatch = !isPmCreated && (!p.projectSnapshot || !p.siteVisit || !p.onField || !p.comments) ? findLeadMatch() : undefined;
            const enriched = {
            id: Number(p.id) || Date.now(),
            title: p.title || 'New Project',
            assignee: (p.assignee || '').toString().slice(0,2).toUpperCase() || 'PM',
            assignees: Array.isArray(p.assignees) ? p.assignees : [],
            date: p.date || '',
            tags: Array.isArray(p.tags) ? p.tags : [],
            priority: (p.priority as any) || 'medium',
            value: p.value || '',
            status: p.status || 'new',
            jobType: p.jobType || undefined,
            customerName: p.customerName || '',
            customerEmail: p.customerEmail || '',
            customerContact: p.customerContact || '',
            customerAddress: p.customerAddress || '',
            comments: p.comments || [],
            // Only include CRM data if NOT PM-created
            projectSnapshot: isPmCreated ? undefined : (p.projectSnapshot || undefined),
            siteVisit: isPmCreated ? undefined : (p.siteVisit || undefined),
            onField: isPmCreated ? undefined : (p.onField || undefined),
            source: p.source || undefined,
            } as any;
            // Only enrich with CRM data if NOT PM-created
            if (leadMatch && !isPmCreated) {
              try {
                if (!enriched.projectSnapshot && (leadMatch as any).projectSnapshot) enriched.projectSnapshot = (leadMatch as any).projectSnapshot;
                if (!enriched.siteVisit && (leadMatch as any).siteVisit) enriched.siteVisit = (leadMatch as any).siteVisit;
                if (!enriched.onField && (leadMatch as any).onField) enriched.onField = (leadMatch as any).onField;
                if ((!enriched.comments || enriched.comments.length === 0) && Array.isArray((leadMatch as any).comments)) {
                  enriched.comments = (leadMatch as any).comments;
                }
              } catch {}
            }
            return enriched;
          });
          // Persist enriched copy back to storage for future loads
          try {
            const toPersist = (incomingCards || []).map((c: any) => {
              const isPm = String(c.source || '') === 'pm' || !!c.jobType;
              return {
                id: c.id, title: c.title, assignee: c.assignee, assignees: c.assignees, date: c.date, tags: c.tags, priority: c.priority,
                value: c.value, status: c.status, jobType: c.jobType, source: c.source,
                customerName: c.customerName, customerEmail: c.customerEmail, customerContact: c.customerContact,
                customerAddress: c.customerAddress, comments: c.comments,
                // Only persist CRM data if NOT PM-created
                projectSnapshot: isPm ? undefined : c.projectSnapshot,
                siteVisit: isPm ? undefined : c.siteVisit,
                onField: isPm ? undefined : c.onField
              };
            });
            localStorage.setItem('xtr_projects', JSON.stringify(toPersist));
          } catch {}
          const ensureUnique = (arr: any[]) => {
            const seen = new Set<string>();
            return arr.filter((item) => {
              const key = String(item.id);
              if (seen.has(key)) return false;
              seen.add(key);
              return true;
            });
          };
          // Start from current columns and place incoming cards by their status
          const next = base.map((c: any) => ({ ...c, projects: Array.isArray(c.projects) ? [...c.projects] : [] }));
          (incomingCards || []).forEach((card: any) => {
            const status = String(card.status || 'new');
            const idx = next.findIndex((c: any) => String(c.id) === status);
            const targetIdx = idx >= 0 ? idx : next.findIndex((c: any) => c.id === 'new');
            if (targetIdx >= 0) {
              const exists = (next[targetIdx].projects || []).some((p: any) => String(p.id) === String(card.id));
              if (!exists) {
                next[targetIdx].projects = ensureUnique([card, ...(next[targetIdx].projects || [])]);
              }
            }
          });
          return next;
        });
      } catch {}
    };
    // Debounce merge to prevent excessive re-renders - skip if dialog is open
    let mergeTimeout: NodeJS.Timeout | null = null;
    const debouncedMerge = () => {
      // Skip merge if dialog is open (user is typing) or merge already in progress
      if (isDialogOpenRef.current || mergeInProgressRef.current) return;
      
      if (mergeTimeout) clearTimeout(mergeTimeout);
      mergeTimeout = setTimeout(() => {
        if (isDialogOpenRef.current || mergeInProgressRef.current) return;
        mergeInProgressRef.current = true;
        try {
          mergeFromLocal();
        } finally {
          mergeInProgressRef.current = false;
        }
      }, 500); // Increased debounce to 500ms for better performance
    };
    
    // Only run initial merge if dialog is not open
    if (!isDialogOpenRef.current) {
      debouncedMerge();
    }
    
    const onStorage = (e: StorageEvent) => { 
      if (e.key === 'xtr_projects' && !isDialogOpenRef.current) {
        debouncedMerge(); 
      }
    };
    const onBroadcast = () => {
      if (!isDialogOpenRef.current) {
        debouncedMerge();
      }
    };
    window.addEventListener('storage', onStorage);
    window.addEventListener('xtr-projects-updated', onBroadcast);
    return () => {
      if (mergeTimeout) clearTimeout(mergeTimeout);
      window.removeEventListener('storage', onStorage);
      window.removeEventListener('xtr-projects-updated', onBroadcast);
    };
  }, [pmProjectsFs]);

  // One-time cleanup: strip CRM data from all PM projects on page load
  useEffect(() => {
    try {
      const raw = localStorage.getItem('xtr_projects');
      const arr = raw ? JSON.parse(raw) : [];
      if (!Array.isArray(arr)) return;
      let needsUpdate = false;
      const cleaned = arr.map((p: any) => {
        const pmColumns = ['site-inspection', 'stage-1', 'stage-2', 'full-system'];
        const isPmColumn = pmColumns.includes(String(p.status || ''));
        const isPm = String(p.source || '') === 'pm' || !!p.jobType || isPmColumn;
        if (isPm && (p.projectSnapshot || p.siteVisit || p.onField)) {
          needsUpdate = true;
          return {
            ...p,
            projectSnapshot: undefined,
            siteVisit: undefined,
            onField: undefined,
          };
        }
        return p;
      });
      if (needsUpdate) {
        localStorage.setItem('xtr_projects', JSON.stringify(cleaned));
        // Also update Firestore (check quota first)
        if (!firestoreQuotaExceeded && !isQuotaExceeded() && firebaseEnabled && db) {
          cleaned.forEach((p: any) => {
            if (isQuotaExceeded()) return; // Skip if quota exceeded
            const isPm = String(p.source || '') === 'pm' || !!p.jobType;
            if (isPm) {
              const q = query(collection(db, 'pm_projects'), where('id', '==', Number(p.id) || p.id));
              getDocs(q).then((snapshot) => {
                if (isQuotaExceeded()) return; // Skip if quota exceeded during async operation
                snapshot.forEach((docSnap) => {
                  if (isQuotaExceeded()) return; // Skip if quota exceeded
                  setDoc(docSnap.ref, p as any, { merge: true }).catch((err: any) => {
                    if (err?.code === 'resource-exhausted') {
                      setQuotaExceeded(true);
                    }
                  });
                });
              }).catch((err: any) => {
                if (err?.code === 'resource-exhausted') {
                  setQuotaExceeded(true);
                }
              });
            }
          });
        }
        try { window.dispatchEvent(new Event('xtr-projects-updated')); } catch {}
      }
    } catch {}
  }, []); // Run once on mount

  // Force-clean CRM data from PM projects when dialog opens (only once when dialog opens)
  const cleanedProjectRef = React.useRef<number | null>(null);
  useEffect(() => {
    if (!showProjectDetails || !editingProject) {
      cleanedProjectRef.current = null;
      return;
    }
    // Only clean once per project when dialog opens
    if (cleanedProjectRef.current === editingProject.id) return;
    
    const proj = editingProject as any;
    const pmColumns = ['site-inspection', 'stage-1', 'stage-2', 'full-system'];
    const isPmColumn = pmColumns.includes(String(proj.status || ''));
    const isPm = String(proj.source || '') === 'pm' || !!proj.jobType || isPmColumn;
    // Only clean if it's a PM project AND has CRM data that shouldn't be there
    if (isPm && ((editingProject as any).projectSnapshot || (editingProject as any).siteVisit || (editingProject as any).onField)) {
      cleanedProjectRef.current = editingProject.id;
      const cleaned = {
        ...editingProject,
        projectSnapshot: undefined,
        siteVisit: undefined,
        onField: undefined,
      };
      setEditingProject(cleaned);
      // Defer updates to avoid blocking UI
      setTimeout(() => {
        // Also update in columns state
        setColumns((prev) => {
          if (!prev) return prev;
          return prev.map((col) => ({
            ...col,
            projects: (col.projects || []).map((p: any) => 
              String(p.id) === String(editingProject.id) ? cleaned : p
            )
          }));
        });
        // Persist cleaned version
        try {
          const raw = localStorage.getItem('xtr_projects');
          const arr = raw ? JSON.parse(raw) : [];
          const updated = Array.isArray(arr) ? arr.map((p: any) => 
            String(p.id) === String(editingProject.id) ? cleaned : p
          ) : [];
          localStorage.setItem('xtr_projects', JSON.stringify(updated));
        } catch {}
      }, 50);
    } else {
      cleanedProjectRef.current = editingProject.id;
    }
  }, [showProjectDetails, editingProject?.id]); // Only run when dialog opens or project ID changes

  // Drag and drop handler
  const handleDragEnd = (result) => {
    const { destination, source, draggableId } = result;

    if (!destination) return;
    if (destination.droppableId === source.droppableId && destination.index === source.index) return;
    if (!columns) return;

    const sourceColumn = columns.find(col => col.id === source.droppableId);
    const destColumn = columns.find(col => col.id === destination.droppableId);
    if (!sourceColumn || !destColumn) return;
    const draggedProject = sourceColumn.projects.find(p => p.id.toString() === draggableId);
    if (!draggedProject) return;

    // Update project status
    const updatedProject = { ...draggedProject, status: destination.droppableId };

    // Remove from source
    const newSourceProjects = sourceColumn.projects.filter(p => p.id.toString() !== draggableId);
    
    // Add to destination
    const newDestProjects = [...destColumn.projects];
    newDestProjects.splice(destination.index, 0, updatedProject);

    // Update columns
    const newColumns = columns.map(col => {
      if (col.id === source.droppableId) {
        return { ...col, projects: newSourceProjects };
      }
      if (col.id === destination.droppableId) {
        return { ...col, projects: newDestProjects };
      }
      return col;
    });

    setColumns(newColumns);
  };

  // Enhanced project click handler for editing
  const handleProjectEditClick = (project) => {
    // Set dialog open ref immediately to prevent merge operations
    isDialogOpenRef.current = true;
    
    // Strip CRM data if this is a PM-created project
    // Also treat projects in PM-specific columns as PM projects
    const pmColumns = ['site-inspection', 'stage-1', 'stage-2', 'full-system'];
    const isPmColumn = pmColumns.includes(String(project.status || ''));
    const isPm = String(project.source || '') === 'pm' || !!project.jobType || isPmColumn;
    const cleaned = isPm ? {
      ...project,
      projectSnapshot: undefined,
      siteVisit: undefined,
      onField: undefined,
    } : project;
    
    // Update local storage immediately (synchronous, fast)
    if (isPm) {
      try {
        const raw = localStorage.getItem('xtr_projects');
        const arr = raw ? JSON.parse(raw) : [];
        const updated = Array.isArray(arr) ? arr.map((p: any) => 
          String(p.id) === String(project.id) ? cleaned : p
        ) : [];
        localStorage.setItem('xtr_projects', JSON.stringify(updated));
      } catch {}
    }
    
    // Set state and open dialog (don't block on Firestore operations)
    setEditingProject(cleaned);
    setSelectedSystemType(project.systemType || project.projectType || "");
    setShowProjectDetails(true);
    
    // REMOVED Firestore update from dialog open handler - this was causing the hang!
    // Firestore updates should only happen on explicit save, not when opening dialog
    // This prevents the page from hanging when quota is exceeded
  };

  // Delete project function
  const handleDeleteProject = async (projectId: number | string) => {
    if (!confirm('Are you sure you want to delete this project?')) return;
    
    // Remove from columns state
    setColumns((prev) => {
      if (!prev) return prev;
        return prev.map((col) => ({
          ...col,
          projects: (col.projects || []).filter((p) => String(p.id) !== String(projectId))
        }));
    });

    // Remove from localStorage
    try {
      const raw = localStorage.getItem('xtr_projects');
      const arr = raw ? JSON.parse(raw) : [];
      const filtered = Array.isArray(arr) ? arr.filter((p: any) => String(p.id) !== String(projectId)) : [];
      localStorage.setItem('xtr_projects', JSON.stringify(filtered));
    } catch {}

    // Remove from Firestore (check quota first)
    try {
      if (!firestoreQuotaExceeded && !isQuotaExceeded() && firebaseEnabled && db) {
        const q = query(collection(db, 'pm_projects'), where('id', '==', Number(projectId) || projectId));
        const snapshot = await getDocs(q);
        if (isQuotaExceeded()) return; // Skip if quota exceeded during async operation
        snapshot.forEach(async (docSnap) => {
          if (isQuotaExceeded()) return; // Skip if quota exceeded
          await deleteDoc(docSnap.ref).catch((err: any) => {
            if (err?.code === 'resource-exhausted') {
              setQuotaExceeded(true);
            }
          });
        });
      }
    } catch (err: any) {
      if (err?.code === 'resource-exhausted') {
        setQuotaExceeded(true);
      }
    }

    setShowProjectDetails(false);
    setEditingProject(null);
    try { window.dispatchEvent(new Event('xtr-projects-updated')); } catch {}
    alert('Project deleted successfully.');
  };

  // Status change handler
  const handleStatusChange = (newStatus) => {
    if (!editingProject) return;
    if (!columns) return;

    const newColumns = columns.map(col => ({
      ...col,
      projects: col.projects.map(p => 
        p.id === editingProject.id 
          ? { ...p, status: newStatus }
          : p
      ).filter(p => p.id !== editingProject.id || col.id === newStatus)
    }));

    // Add project to new column if it's not already there
    const targetColumn = newColumns.find(col => col.id === newStatus);
    if (targetColumn && !targetColumn.projects.find(p => p.id === editingProject.id)) {
      targetColumn.projects.push({ ...editingProject, status: newStatus });
    }

    setColumns(newColumns);
    setEditingProject({ ...editingProject, status: newStatus });
  };

  // Comment submission handler
  const handleSubmitComment = () => {
    if (!commentText.trim() || !editingProject) return;

    const newComment = {
      id: Date.now().toString(),
      text: commentText,
      author: "Project Manager", // This would come from auth context
      email: userEmail,
      timestamp: new Date().toLocaleString()
    };

    const updatedProject = {
      ...editingProject,
      comments: [...(editingProject.comments || []), newComment]
    };

    // Update the project in columns
    if (!columns) return;
    const newColumns = columns.map(col => ({
      ...col,
      projects: col.projects.map(p => 
        p.id === editingProject.id ? updatedProject : p
      )
    }));

    setColumns(newColumns);
    setEditingProject(updatedProject);
    setCommentText("");
  };

  // Update project details handler
  const handleUpdateProject = (updatedData) => {
    if (!editingProject) return;
    if (!columns) return;

    const updatedProject = { ...editingProject, ...updatedData };

    const newColumns = columns.map(col => ({
      ...col,
      projects: col.projects.map(p => 
        p.id === editingProject.id ? updatedProject : p
      )
    }));

    setColumns(newColumns);
    setEditingProject(updatedProject);
  };

  try {
  return (
    <div className="space-y-6">
      {/* Firestore Quota Warning Banner */}
      {firestoreQuotaExceeded && (
        <div className="bg-yellow-50 border-l-4 border-yellow-400 p-4 rounded-md">
          <div className="flex items-center">
            <AlertCircle className="w-5 h-5 text-yellow-400 mr-3" />
            <div className="flex-1">
              <p className="text-sm text-yellow-800">
                <strong>Firestore quota exceeded.</strong> The app is now running in offline mode using local storage only. 
                All your data is saved locally and will sync when the quota resets or you upgrade your Firebase plan.
              </p>
            </div>
            <Button 
              variant="ghost" 
              size="sm" 
              onClick={() => setQuotaExceeded(false)}
              className="text-yellow-800 hover:text-yellow-900"
            >
              <X className="w-4 h-4" />
            </Button>
          </div>
        </div>
      )}

      <div className="flex items-center justify-between">
        <div>
            <h1 className="text-3xl font-bold text-gray-900">Project Management</h1>
          <p className="text-muted-foreground">Schedule and manage installations</p>
        </div>
        <div className="flex gap-3">
            <Button variant="outline" onClick={handleExportSchedule}>
            <CalendarIcon className="w-4 h-4 mr-2" />
            Export Schedule
          </Button>
            <Button onClick={handleScheduleNewProject}>Schedule New Project</Button>
        </div>
      </div>

      <Tabs defaultValue="kanban">
        <TabsList>
          <TabsTrigger value="kanban">Kanban View</TabsTrigger>
          <TabsTrigger value="calendar">Calendar View</TabsTrigger>
          <TabsTrigger value="resources">Resource Allocation</TabsTrigger>
          <Button variant="outline" size="sm" onClick={handleForceSync} className="ml-2">Sync to Cloud</Button>
        </TabsList>

        <TabsContent value="kanban" className="mt-6 space-y-4">
          <Card>
            <CardHeader>
              <div className="flex items-center justify-between">
                <CardTitle>Project Timeline</CardTitle>
                <div className="flex items-center gap-2">
                  <Button variant="outline" size="sm" onClick={() => handleCalendarNavigation('previous')}>
                    <ChevronLeft className="w-4 h-4" />
                  </Button>
                  <span>{currentMonthLabel}</span>
                  <Button variant="outline" size="sm" onClick={() => handleCalendarNavigation('next')}>
                    <ChevronRight className="w-4 h-4" />
                  </Button>
                </div>
              </div>
            </CardHeader>
            <CardContent>
              <DragDropContext onDragEnd={handleDragEnd}>
                <div className="flex gap-4 overflow-x-auto pb-4" key="kanban-columns-12">
                  {(columns || kanbanColumns).map((column) => {
                    return (
                    <div key={column.id} className="space-y-4 min-w-[280px] flex-shrink-0">
                    <div className={`border-l-4 ${column.color} pl-3`}>
                      <div className="flex items-center justify-between mb-2">
                          <h3 className="text-sm font-semibold truncate">{column.title}</h3>
                          <Badge variant="secondary" className="ml-2 flex-shrink-0">{column.projects.length}</Badge>
                      </div>
                        <p className="text-xs text-muted-foreground">
                          {column.id === "new" && "New projects awaiting review"}
                          {column.id === "site-inspection" && "Site inspection scheduled/completed"}
                          {column.id === "stage-1" && "Stage 1 installation phase"}
                          {column.id === "stage-2" && "Stage 2 installation phase"}
                          {column.id === "full-system" && "Full system installation"}
                          {column.id === "canceled" && "Canceled projects"}
                          {column.id === "to-be-scheduled" && "Ready for scheduling"}
                          {column.id === "scheduled" && "Confirmed schedule"}
                          {column.id === "to-be-rescheduled" && "Schedule changes needed"}
                          {column.id === "completed" && "Installation completed"}
                          {column.id === "ces-certificate-applied" && "Certificate applied"}
                          {column.id === "ces-certificate-received" && "Certificate received"}
                          {column.id === "ces-certificate-submitted" && "Certificate submitted"}
                          {column.id === "grid-connect-initiated" && "Grid connection process started"}
                          {column.id === "grid-connection-completed" && "Grid connection established"}
                          {column.id === "system-handover" && "System ready for customer handover"}
                          {column.id === "done" && "Project fully completed"}
                      </p>
                    </div>

                      <Droppable droppableId={column.id}>
                        {(provided, snapshot) => (
                          <div
                            {...provided.droppableProps}
                            ref={provided.innerRef}
                            className={`space-y-3 min-h-[200px] p-2 rounded-lg transition-colors ${
                              snapshot.isDraggingOver ? 'bg-blue-50 border-2 border-blue-200' : ''
                            }`}
                          >
                            {column.projects.map((project, index) => (
                              <Draggable key={project.id} draggableId={project.id.toString()} index={index}>
                                {(provided, snapshot) => (
                                  <div
                                    ref={provided.innerRef}
                                    {...provided.draggableProps}
                                    {...provided.dragHandleProps}
                                    className={`cursor-pointer transition-transform ${
                                      snapshot.isDragging ? 'rotate-3 shadow-lg' : ''
                                    }`}
                                    onClick={() => handleProjectEditClick(project)}
                                  >
                        <KanbanCard
                          title={project.title}
                          assignee={project.assignee}
                          date={project.date}
                          tags={project.tags}
                          priority={project.priority}
                          value={project.value}
                        />
                                  </div>
                                )}
                              </Draggable>
                      ))}
                            {provided.placeholder}
                      
                      {/* Only show Add Project button for specific columns */}
                      {!["new", "canceled", "to-be-scheduled", "scheduled", "to-be-rescheduled", "completed", "ces-certificate-applied", "ces-certificate-received", "ces-certificate-submitted", "grid-connect-initiated", "grid-connection-completed", "system-handover", "done"].includes(column.id) && (
                      <Button 
                        variant="ghost" 
                        className="w-full border-2 border-dashed hover:border-solid hover:bg-muted"
                          onClick={() => handleAddProject(column.id)}
                      >
                        <Plus className="w-4 h-4 mr-2" />
                        Add Project
                      </Button>
                      )}
                    </div>
                        )}
                      </Droppable>
                  </div>
                    );
                  })}
              </div>
              </DragDropContext>
            </CardContent>
          </Card>

          {/* Summary Stats */}
          <div className="grid grid-cols-1 md:grid-cols-4 gap-4">
            <Card className="cursor-pointer hover:shadow-md transition-shadow" onClick={() => handleStatsClick('total')}>
              <CardContent className="p-4">
                <div className="flex items-center justify-between">
                  <div>
                    <p className="text-muted-foreground">Total Projects</p>
                    <h3 className="mt-1">12</h3>
                  </div>
                  <div className="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
                    <CalendarIcon className="w-6 h-6 text-primary" />
                  </div>
                </div>
              </CardContent>
            </Card>

            <Card className="cursor-pointer hover:shadow-md transition-shadow" onClick={() => handleStatsClick('in-progress')}>
              <CardContent className="p-4">
                <div className="flex items-center justify-between">
                  <div>
                    <p className="text-muted-foreground">In Progress</p>
                    <h3 className="mt-1">2</h3>
                  </div>
                  <div className="w-12 h-12 rounded-full bg-warning/10 flex items-center justify-center">
                    <Clock className="w-6 h-6 text-warning" />
                  </div>
                </div>
              </CardContent>
            </Card>

            <Card className="cursor-pointer hover:shadow-md transition-shadow" onClick={() => handleStatsClick('completed')}>
              <CardContent className="p-4">
                <div className="flex items-center justify-between">
                  <div>
                    <p className="text-muted-foreground">Completed</p>
                    <h3 className="mt-1">2</h3>
                  </div>
                  <div className="w-12 h-12 rounded-full bg-success/10 flex items-center justify-center">
                    <CheckCircle className="w-6 h-6 text-success" />
                  </div>
                </div>
              </CardContent>
            </Card>

            <Card className="cursor-pointer hover:shadow-md transition-shadow" onClick={() => handleStatsClick('value')}>
              <CardContent className="p-4">
                <div className="flex items-center justify-between">
                  <div>
                    <p className="text-muted-foreground">Total Value</p>
                    <h3 className="mt-1">$188K</h3>
                  </div>
                  <div className="w-12 h-12 rounded-full bg-secondary/10 flex items-center justify-center">
                    <DollarSign className="w-6 h-6 text-secondary" />
                  </div>
                </div>
              </CardContent>
            </Card>
          </div>
        </TabsContent>

        <TabsContent value="calendar" className="mt-6">
          <Card>
            <CardHeader>
              <div className="flex items-center justify-between">
                <div className="flex items-center gap-4">
                  <CardTitle>Schedule</CardTitle>
                <div className="flex items-center gap-2">
                    <Button 
                      variant={calendarViewType === "weekly" ? "default" : "outline"} 
                      size="sm"
                      onClick={() => setCalendarViewType("weekly")}
                    >
                      Weekly Schedule
                    </Button>
                    <Button 
                      variant={calendarViewType === "monthly" ? "default" : "outline"} 
                      size="sm"
                      onClick={() => setCalendarViewType("monthly")}
                    >
                      Monthly Schedule
                    </Button>
                  </div>
                </div>
                <div className="flex items-center gap-2">
                  <Button variant="outline" size="sm" onClick={() => handleCalendarNavigation('previous')}>
                    <ChevronLeft className="w-4 h-4" />
                  </Button>
                  <span>{calendarViewType === "weekly" ? currentWeekLabel : currentMonthLabel}</span>
                  <Button variant="outline" size="sm" onClick={() => handleCalendarNavigation('next')}>
                    <ChevronRight className="w-4 h-4" />
                  </Button>
                </div>
              </div>
            </CardHeader>
            <CardContent>
              {calendarViewType === "weekly" ? (
              <div className="grid grid-cols-5 gap-4">
                  {weeklySchedule.map((day, index) => (
                  <div key={index} className="border rounded-lg p-4">
                      <h4 className="mb-3 font-semibold">{day.day}</h4>
                    <div className="space-y-2">
                      {day.projects.map((project, idx) => (
                        <div
                          key={idx}
                            className="p-3 bg-primary/10 border border-primary/20 rounded text-primary cursor-pointer hover:bg-primary/20 transition-colors"
                            onClick={() => handleScheduleItemClick(project)}
                        >
                            <p className="font-medium text-sm">{project.title}</p>
                            <p className="text-xs text-muted-foreground mt-1">{project.time}</p>
                        </div>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
              ) : (
                <div className="grid grid-cols-7 gap-2">
                  {/* Calendar Header */}
                  {["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"].map((day) => (
                    <div key={day} className="p-2 text-center font-semibold text-muted-foreground">
                      {day}
                    </div>
                  ))}
                  
                  {/* Empty cells for calendar alignment */}
                  {Array.from({ length: monthlyCalendar.leadingBlankCount }, (_, index) => (
                    <div key={`leading-${index}`} className="p-2 h-24 border rounded"></div>
                  ))}

                  {/* Calendar days with projects */}
                  {monthlyCalendar.days.map((day, index) => (
                    <div key={day.date.toISOString()} className="p-2 h-24 border rounded">
                      <div className="text-sm font-medium mb-1">
                        {day.date.getDate()}
                      </div>
                      <div className="space-y-1">
                        {day.projects.map((project, idx) => (
                          <div
                            key={`${project.id ?? project.title}-${idx}`}
                            className="text-xs p-1 bg-primary/10 border border-primary/20 rounded text-primary cursor-pointer hover:bg-primary/20 transition-colors truncate"
                            onClick={() => handleScheduleItemClick(project)}
                            title={project.title}
                          >
                            {project.title}
                          </div>
                        ))}
                      </div>
                    </div>
                  ))}

                  {/* Fill remaining calendar cells */}
                  {Array.from({ length: monthlyCalendar.trailingBlankCount }, (_, i) => (
                    <div key={`trailing-${i}`} className="p-2 h-24 border rounded"></div>
                  ))}
                </div>
              )}
            </CardContent>
          </Card>
        </TabsContent>

        <TabsContent value="resources" className="mt-6 space-y-6">
          <Card>
            <CardHeader>
              <CardTitle>Team Availability</CardTitle>
            </CardHeader>
            <CardContent>
              <div className="space-y-4">
                {team.map((member) => (
                  <div key={member.id} className="p-4 border rounded-lg cursor-pointer hover:shadow-md transition-shadow" onClick={() => handleTeamMemberClick(member)}>
                    <div className="flex items-center justify-between mb-3">
                      <div>
                        <p>{member.name}</p>
                        <p className="text-muted-foreground">{member.role}</p>
                      </div>
                      <div className="text-right">
                        <p>{member.availability}% Available</p>
                        <p className="text-muted-foreground">{member.projects} active projects</p>
                      </div>
                    </div>
                    <div className="relative h-2 bg-muted rounded-full overflow-hidden">
                      <div
                        className={`absolute inset-y-0 left-0 rounded-full ${
                          member.availability > 70
                            ? "bg-success"
                            : member.availability > 40
                            ? "bg-warning"
                            : "bg-destructive"
                        }`}
                        style={{ width: `${member.availability}%` }}
                      />
                    </div>
                  </div>
                ))}
              </div>
            </CardContent>
          </Card>

          <Card>
            <CardHeader>
              <CardTitle>Availability Heatmap</CardTitle>
            </CardHeader>
            <CardContent>
              <div className="grid grid-cols-6 gap-2">
                <div className="p-2"></div>
                {["Mon", "Tue", "Wed", "Thu", "Fri"].map((day) => (
                  <div key={day} className="p-2 text-center text-muted-foreground">
                    {day}
                  </div>
                ))}

                {team.map((member) => (
                  <React.Fragment key={member.id}>
                    <div className="p-2 text-muted-foreground">{member.name.split(" ")[0]}</div>
                    {[90, 60, 80, 70, 85].map((avail, idx) => (
                      <div
                        key={idx}
                        className={`p-4 rounded text-center cursor-pointer ${
                          avail > 70
                            ? "bg-success/20 hover:bg-success/30"
                            : avail > 40
                            ? "bg-warning/20 hover:bg-warning/30"
                            : "bg-destructive/20 hover:bg-destructive/30"
                        }`}
                        onClick={() => handleAvailabilityClick(member, ["Mon", "Tue", "Wed", "Thu", "Fri"][idx], avail)}
                      >
                        {avail}%
                      </div>
                    ))}
                  </React.Fragment>
                ))}
              </div>

              <div className="flex items-center gap-6 mt-6">
                <div className="flex items-center gap-2">
                  <div className="w-4 h-4 bg-success/20 rounded" />
                  <span className="text-muted-foreground">70-100% Available</span>
                </div>
                <div className="flex items-center gap-2">
                  <div className="w-4 h-4 bg-warning/20 rounded" />
                  <span className="text-muted-foreground">40-70% Available</span>
                </div>
                <div className="flex items-center gap-2">
                  <div className="w-4 h-4 bg-destructive/20 rounded" />
                  <span className="text-muted-foreground">0-40% Available</span>
                </div>
              </div>
            </CardContent>
          </Card>

          <Card>
            <CardHeader>
              <CardTitle>Drag to Schedule</CardTitle>
            </CardHeader>
            <CardContent>
              <div className="p-8 border-2 border-dashed rounded-lg text-center">
                <Users className="w-12 h-12 mx-auto mb-4 text-muted-foreground" />
                <p className="text-muted-foreground mb-2">Drag projects to team members to assign</p>
                <Button variant="outline">View Interactive Scheduler</Button>
              </div>
            </CardContent>
          </Card>
        </TabsContent>
      </Tabs>

      {/* Dialogs */}
      {/* Export Schedule Dialog */}
      <Dialog open={showExportDialog} onOpenChange={setShowExportDialog}>
        <DialogContent>
          <DialogHeader>
            <DialogTitle className="flex items-center gap-2">
              <Download className="w-5 h-5" />
              Export Schedule
            </DialogTitle>
          </DialogHeader>
          <div className="space-y-4">
            <div>
              <Label>Export Format</Label>
              <Select>
                <SelectTrigger>
                  <SelectValue placeholder="Select format" />
                </SelectTrigger>
                <SelectContent>
                  <SelectItem value="csv">CSV</SelectItem>
                  <SelectItem value="excel">Excel</SelectItem>
                  <SelectItem value="pdf">PDF</SelectItem>
                </SelectContent>
              </Select>
            </div>
            <div>
              <Label>Date Range</Label>
              <div className="grid grid-cols-2 gap-2">
                <Input type="date" placeholder="Start Date" />
                <Input type="date" placeholder="End Date" />
              </div>
            </div>
            <div>
              <Label>Include</Label>
              <div className="space-y-2">
                <div className="flex items-center space-x-2">
                  <input type="checkbox" id="projects" defaultChecked />
                  <Label htmlFor="projects">Project Details</Label>
                </div>
                <div className="flex items-center space-x-2">
                  <input type="checkbox" id="team" defaultChecked />
                  <Label htmlFor="team">Team Assignments</Label>
                </div>
                <div className="flex items-center space-x-2">
                  <input type="checkbox" id="timeline" defaultChecked />
                  <Label htmlFor="timeline">Timeline</Label>
                </div>
              </div>
            </div>
          </div>
          <DialogFooter>
            <Button variant="outline" onClick={() => setShowExportDialog(false)}>
              Cancel
            </Button>
            <Button onClick={handleExportConfirm}>
              <Download className="w-4 h-4 mr-2" />
              Export
            </Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>

      {/* New Project Dialog */}
      <Dialog open={showNewProjectDialog} onOpenChange={(open) => {
        setShowNewProjectDialog(open);
        isDialogOpenRef.current = open;
      }}>
        <DialogContent className="max-w-4xl p-0" style={{ maxHeight: '90vh', height: '90vh', display: 'flex', flexDirection: 'column' }}>
          <div className="flex flex-col h-full overflow-hidden">
            <DialogHeader className="px-6 pt-6 pb-4 border-b flex-shrink-0">
            <DialogTitle className="flex items-center justify-between">
              <span>Schedule New Project</span>
                <Button variant="ghost" size="sm" onClick={() => {
                  setShowNewProjectDialog(false);
                  isDialogOpenRef.current = false;
                }}>
                <X className="w-4 h-4" />
              </Button>
            </DialogTitle>
          </DialogHeader>
          
            <div className="flex-1 overflow-y-auto px-6 py-4 [&::-webkit-scrollbar]:w-2 [&::-webkit-scrollbar-track]:bg-gray-100 [&::-webkit-scrollbar-thumb]:bg-gray-300 [&::-webkit-scrollbar-thumb]:rounded-full [&::-webkit-scrollbar-thumb]:hover:bg-gray-400" style={{ scrollbarWidth: 'thin', scrollbarColor: '#cbd5e0 #f7fafc' }}>
          <div className="space-y-6">
            {/* Project Overview */}
            <div className="space-y-4">
              <h3 className="text-lg font-semibold">Project Overview</h3>
              <div className="grid grid-cols-2 md:grid-cols-3 gap-4">
                <div className="space-y-2">
                  <Label>Project Name</Label>
                  <Input 
                    value={newProject.title}
                    onChange={(e) => setNewProject((prev) => ({ ...prev, title: e.target.value }))}
                    placeholder="Enter project name"
                  />
                </div>
                <div className="space-y-2">
                  <Label>Phone</Label>
                  <Input 
                    value={newProject.value}
                    onChange={(e) => setNewProject((prev) => ({ ...prev, value: e.target.value }))}
                    placeholder="e.g., 0400 123 456"
                  />
                </div>
                <div className="space-y-2">
                  <Label>Priority</Label>
                  <Select value={newProject.priority} onValueChange={(value) => setNewProject((prev) => ({ ...prev, priority: value }))}>
                    <SelectTrigger>
                      <SelectValue placeholder="Select priority" />
                    </SelectTrigger>
                    <SelectContent>
                      <SelectItem value="low">Low</SelectItem>
                      <SelectItem value="medium">Medium</SelectItem>
                      <SelectItem value="high">High</SelectItem>
                    </SelectContent>
                  </Select>
                </div>
                <div className="space-y-2">
                  <Label>Client Type</Label>
                  <Select value={newProject.clientType} onValueChange={(value) => setNewProject((prev) => ({ ...prev, clientType: value }))}>
                    <SelectTrigger>
                      <SelectValue placeholder="Select client type" />
                    </SelectTrigger>
                    <SelectContent>
                      <SelectItem value="retailer">Retailer</SelectItem>
                      <SelectItem value="builder">Builder</SelectItem>
                    </SelectContent>
                  </Select>
                </div>
                <div className="space-y-2">
                  <Label>Client Name</Label>
                  <Textarea
                    value={newProject.clientName}
                    onChange={(e) => setNewProject((prev) => ({ ...prev, clientName: e.target.value }))}
                    placeholder="Enter client name"
                    rows={3}
                  />
                </div>
                <div className="space-y-2">
                  <Label>Job Type</Label>
                  <Select value={newProject.jobType || ""} onValueChange={(value) => setNewProject((prev) => ({ ...prev, jobType: value }))}>
                    <SelectTrigger>
                      <SelectValue placeholder="Select job type" />
                    </SelectTrigger>
                    <SelectContent>
                      <SelectItem value="site-inspection">Site Inspection</SelectItem>
                      <SelectItem value="stage-1">Stage 1</SelectItem>
                      <SelectItem value="stage-2">Stage 2</SelectItem>
                      <SelectItem value="full-system">Full System</SelectItem>
                    </SelectContent>
                  </Select>
                </div>
              </div>

              {/* Site Inspection Booking - Show only when Site Inspection is selected */}
              {newProject.jobType === "site-inspection" && !newProject.inspectionBooked && (
                <div className="space-y-4 p-4 border border-blue-200 rounded-lg bg-blue-50">
                  <h4 className="text-md font-semibold text-blue-800">Book Site Inspection</h4>
                  <div className="grid grid-cols-2 gap-4">
                    <div className="space-y-2">
                      <Label>Inspection Date</Label>
                      <Input
                        type="date"
                        value={newProject.inspectionDate}
                        onChange={(e) => setNewProject((prev) => ({ ...prev, inspectionDate: e.target.value }))}
                        min={new Date().toISOString().split('T')[0]}
                      />
                    </div>
                    <div className="space-y-2">
                      <Label>Time Slot</Label>
                      <Select value={newProject.inspectionTime} onValueChange={(value) => setNewProject((prev) => ({ ...prev, inspectionTime: value }))}>
                        <SelectTrigger>
                          <SelectValue placeholder="Select time slot" />
                        </SelectTrigger>
                        <SelectContent>
                          <SelectItem value="09:00">9:00 AM</SelectItem>
                          <SelectItem value="10:00">10:00 AM</SelectItem>
                          <SelectItem value="11:00">11:00 AM</SelectItem>
                          <SelectItem value="12:00">12:00 PM</SelectItem>
                          <SelectItem value="13:00">1:00 PM</SelectItem>
                          <SelectItem value="14:00">2:00 PM</SelectItem>
                          <SelectItem value="15:00">3:00 PM</SelectItem>
                          <SelectItem value="16:00">4:00 PM</SelectItem>
                          <SelectItem value="17:00">5:00 PM</SelectItem>
                        </SelectContent>
                      </Select>
                    </div>
                  </div>
                  <div className="flex justify-center mt-6 mb-4">
                    <Button 
                      onClick={() => {
                        if (newProject.inspectionDate && newProject.inspectionTime) {
                          setNewProject((prev) => ({ ...prev, inspectionBooked: true }));
                          alert(`Site inspection booked for ${new Date(newProject.inspectionDate).toLocaleDateString()} at ${formatTimeDisplay(newProject.inspectionTime)}`);
                        } else {
                          alert("Please select both date and time slot for the inspection.");
                        }
                      }}
                      className="px-4 py-2 text-sm font-medium rounded-md shadow-md"
                      style={{ 
                        minHeight: '36px', 
                        minWidth: '150px',
                        backgroundColor: '#000000',
                        color: '#ffffff',
                        border: '1px solid #333333'
                      }}
                    >
                      <CalendarIcon className="w-4 h-4 mr-2" style={{ color: '#ffffff' }} />
                      <span style={{ color: '#ffffff' }}>Book Site Inspection</span>
                    </Button>
                  </div>
                </div>
              )}

              {/* Site Inspection Summary - Show after booking */}
              {newProject.jobType === "site-inspection" && newProject.inspectionBooked && (
                <div className="space-y-4 p-4 border border-green-200 rounded-lg bg-green-50">
                  <div className="flex items-center justify-between">
                    <h4 className="text-md font-semibold text-green-800">Site Inspection Booked</h4>
                    <Button
                      variant="outline"
                      size="sm"
                      onClick={() => setNewProject((prev) => ({ ...prev, inspectionBooked: false }))}
                      className="text-xs"
                    >
                      Edit
                    </Button>
                  </div>
                  <div className="grid grid-cols-3 gap-4">
                    <div className="space-y-1">
                      <Label className="text-sm font-medium text-gray-600">Job Type</Label>
                      <p className="text-sm font-semibold">Site Inspection</p>
                    </div>
                    <div className="space-y-1">
                      <Label className="text-sm font-medium text-gray-600">Date</Label>
                      <p className="text-sm font-semibold">
                        {newProject.inspectionDate ? new Date(newProject.inspectionDate).toLocaleDateString() : "Not set"}
                      </p>
                    </div>
                    <div className="space-y-1">
                      <Label className="text-sm font-medium text-gray-600">Time</Label>
                      <p className="text-sm font-semibold">
                        {newProject.inspectionTime ? formatTimeDisplay(newProject.inspectionTime) : "Not set"}
                      </p>
                    </div>
                  </div>
                </div>
              )}

              {/* Stage 1 Booking - Show only when Stage 1 is selected */}
              {newProject.jobType === "stage-1" && !newProject.stage1Booked && (
                <div className="space-y-4 p-4 border border-blue-200 rounded-lg bg-blue-50">
                  <h4 className="text-md font-semibold text-blue-800">Book Stage 1</h4>
                  <div className="space-y-2">
                    <Label>Stage 1 Date</Label>
                    <Input
                      type="date"
                      value={newProject.stage1Date}
                      onChange={(e) => setNewProject((prev) => ({ ...prev, stage1Date: e.target.value }))}
                      min={new Date().toISOString().split('T')[0]}
                    />
                  </div>
                  <div className="flex justify-center mt-6 mb-4">
                    <Button 
                      onClick={() => {
                        if (newProject.stage1Date) {
                          setNewProject((prev) => ({ ...prev, stage1Booked: true }));
                          alert(`Stage 1 booked for ${new Date(newProject.stage1Date).toLocaleDateString()}`);
                        } else {
                          alert("Please select a date for Stage 1.");
