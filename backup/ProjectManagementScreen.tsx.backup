                  <Select value={newProject.meterPhase} onValueChange={(value) => setNewProject((prev) => ({ ...prev, meterPhase: value }))}>
                    <SelectTrigger>
                      <SelectValue placeholder="Select meter phase" />
                    </SelectTrigger>
                    <SelectContent>
                      <SelectItem value="single">Single</SelectItem>
                      <SelectItem value="double">Double</SelectItem>
                      <SelectItem value="three">Three</SelectItem>
                    </SelectContent>
                  </Select>
                </div>
                <div className="space-y-2">
                  <Label>Access To 2nd Storey</Label>
                  <Select value={newProject.accessTo2ndStorey} onValueChange={(value) => setNewProject((prev) => ({ ...prev, accessTo2ndStorey: value }))}>
                    <SelectTrigger>
                      <SelectValue placeholder="Select access" />
                    </SelectTrigger>
                    <SelectContent>
                      <SelectItem value="yes">Yes</SelectItem>
                      <SelectItem value="no">No</SelectItem>
                      <SelectItem value="na">NA</SelectItem>
                    </SelectContent>
                  </Select>
